# Copy this file to .env and fill in the two required values.
# .env is git-ignored — never commit real tokens.

# REQUIRED — from @BotFather (/newbot). Format: 123456789:AAAA...
TG_TOKEN=

# REQUIRED — the channel/group the alerts go to.
# Add the bot to the group as admin, send any message there, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}
# Group/channel ids are usually negative, e.g. -1001234567890
TG_CHAT_ID=

# OPTIONAL — where fetch-error reports go (defaults to TG_CHAT_ID)
TG_ADMIN_CHAT_ID=

# OPTIONAL — what to monitor. Defaults: Bitcoin/USD via CoinGecko's free API.
# TARGET_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd
# JSON_PATH=bitcoin.usd
# TARGET_NAME=Bitcoin price (USD)

# OPTIONAL — when to alert: change | threshold_above | threshold_below | report
# "change": alert when the value differs from the last run (default)
# "threshold_*": alert once when the value crosses THRESHOLD
# "report": alert every run (daily-report mode)
# ALERT_MODE=change
# THRESHOLD=100000
